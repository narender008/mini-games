{
  "name": "magic-brush-tests",
  "private": true,
  "description": "Automated tests for Magic Brush: browser smoke tests, the full loop with real mouse and touch input, regressions of the old game's bugs, every friend, the meadow, performance and screenshots.",
  "scripts": {
    "test": "node run.cjs",
    "smoke": "node --test --test-reporter=spec smoke.test.cjs",
    "loop": "node --test --test-reporter=spec loop.test.cjs",
    "regressions": "node --test --test-reporter=spec regressions.test.cjs",
    "friends": "node --test --test-reporter=spec friends.test.cjs",
    "meadow": "node --test --test-reporter=spec meadow.test.cjs",
    "perf": "node --test --test-reporter=spec perf.test.cjs",
    "shots": "node screenshots.cjs"
  },
  "devDependencies": {
    "playwright": "1.63.0"
  }
}
