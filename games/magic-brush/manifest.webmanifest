{
  "name": "Magic Brush",
  "short_name": "Magic Brush",
  "description": "Paint a friend on the easel, wave the magic wand and watch it come alive in your own colours, then play with it in a sunny meadow. No words, no timers, nothing to lose.",
  "start_url": "./",
  "scope": "./",
  "display": "fullscreen",
  "display_override": ["fullscreen", "standalone"],
  "orientation": "any",
  "background_color": "#8fcbef",
  "theme_color": "#8fcbef",
  "icons": [
    { "src": "icon.svg", "sizes": "any", "type": "image/svg+xml" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "apple-touch-icon.png", "sizes": "180x180", "type": "image/png" }
  ]
}
